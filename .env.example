# Sinka Admin Frontend — Environment Configuration Template
# Copy this file to .env for local development and fill in values.
# For production, configure these variables in Netlify Site Configuration.
VITE_API_BASE_URL=http://localhost:5001

# Firebase Client Web App Configuration (Browser / Public credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
